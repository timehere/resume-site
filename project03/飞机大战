<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#0a0a1a" />
  <title>星际战甲 · Plane War</title>
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>
  <div id="game-container">
    <canvas id="game-canvas" width="450" height="800"></canvas>

    <!-- 主菜单 -->
    <div id="menu-screen" class="overlay">
      <div class="menu-content">
        <h1 class="game-title">
          <span class="title-glow">星际战甲</span>
        </h1>
        <p class="subtitle">PLANE WAR · CYBER EDITION</p>
        <div class="menu-buttons">
          <button class="btn btn-primary" data-action="start">开始游戏</button>
          <button class="btn" data-action="select-level">选择关卡</button>
          <button class="btn" data-action="how-to-play">操作说明</button>
        </div>
        <div class="high-score">
          <span>最高分</span>
          <span id="high-score-value">0</span>
        </div>
      </div>
    </div>

    <!-- 关卡选择 -->
    <div id="level-select" class="overlay hidden">
      <div class="menu-content">
        <h2 class="section-title">选择关卡</h2>
        <div id="level-list" class="level-list"></div>
        <button class="btn btn-back" data-action="back-menu">返回</button>
      </div>
    </div>

    <!-- 操作说明 -->
    <div id="how-to-play" class="overlay hidden">
      <div class="menu-content">
        <h2 class="section-title">操作说明</h2>
        <div class="instructions">
          <div class="instruction-group">
            <h3>键盘操作</h3>
            <p><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> / 方向键 — 移动飞机</p>
            <p><kbd>空格</kbd> / <kbd>J</kbd> — 射击（按住连发）</p>
            <p><kbd>K</kbd> / <kbd>B</kbd> — 释放炸弹</p>
            <p><kbd>P</kbd> / <kbd>ESC</kbd> — 暂停</p>
          </div>
          <div class="instruction-group">
            <h3>触屏操作</h3>
            <p>按住屏幕拖动 — 控制飞机移动</p>
            <p>自动开火 — 无需手动射击</p>
            <p>双击屏幕 — 释放炸弹</p>
          </div>
        </div>
        <button class="btn btn-back" data-action="back-menu">返回</button>
      </div>
    </div>

    <!-- 战斗HUD -->
    <div id="battle-hud" class="overlay hidden hud-layer">
      <div class="hud-top">
        <div class="hud-left">
          <div class="bar-group">
            <div class="bar-label">HP</div>
            <div class="bar bar-hp"><div id="hp-fill" class="bar-fill"></div></div>
          </div>
          <div class="bar-group">
            <div class="bar-label">SHIELD</div>
            <div class="bar bar-shield"><div id="shield-fill" class="bar-fill"></div></div>
          </div>
        </div>
        <div class="hud-center">
          <div id="boss-hp-container" class="boss-hp-container hidden">
            <div id="boss-name" class="boss-name"></div>
            <div class="bar bar-boss"><div id="boss-hp-fill" class="bar-fill"></div></div>
          </div>
        </div>
        <div class="hud-right">
          <button id="pause-btn" class="btn-icon" title="暂停">⏸</button>
        </div>
      </div>
      <div class="hud-bottom">
        <div class="hud-stat">
          <span class="stat-label">SCORE</span>
          <span id="score-value" class="stat-value">0</span>
        </div>
        <div class="hud-stat">
          <span class="stat-label">COMBO</span>
          <span id="combo-value" class="stat-value combo-value">0</span>
          <span id="combo-multiplier" class="combo-multiplier hidden">x2</span>
        </div>
        <div class="hud-stat">
          <span class="stat-label">BOMB</span>
          <span id="bomb-value" class="stat-value">3</span>
        </div>
        <div class="hud-stat">
          <span class="stat-label">WEAPON</span>
          <span id="weapon-value" class="stat-value">Lv.1</span>
        </div>
      </div>
      <div id="bomb-btn" class="bomb-btn" title="释放炸弹 (K)">💣</div>
    </div>

    <!-- 暂停菜单 -->
    <div id="pause-screen" class="overlay hidden">
      <div class="menu-content">
        <h2 class="section-title">游戏暂停</h2>
        <div class="menu-buttons">
          <button class="btn btn-primary" data-action="resume">继续游戏</button>
          <button class="btn" data-action="restart">重新开始</button>
          <button class="btn" data-action="to-menu">返回主菜单</button>
        </div>
      </div>
    </div>

    <!-- Boss警告 -->
    <div id="boss-warning" class="overlay hidden warning-layer">
      <div class="warning-content">
        <div class="warning-text">⚠ WARNING ⚠</div>
        <div class="subtitle">INCOMING BOSS</div>
      </div>
    </div>

    <!-- 关卡完成 -->
    <div id="level-complete" class="overlay hidden">
      <div class="menu-content">
        <h2 class="section-title success">关卡通过！</h2>
        <div class="result-stats">
          <div class="result-row"><span>本关得分</span><span id="level-score">0</span></div>
          <div class="result-row"><span>最高连击</span><span id="level-max-combo">0</span></div>
          <div class="result-row"><span>击落敌机</span><span id="level-kills">0</span></div>
        </div>
        <div class="menu-buttons">
          <button class="btn btn-primary" data-action="next-level">下一关</button>
          <button class="btn" data-action="to-menu">返回主菜单</button>
        </div>
      </div>
    </div>

    <!-- 游戏结束 -->
    <div id="game-over" class="overlay hidden">
      <div class="menu-content">
        <h2 class="section-title danger">GAME OVER</h2>
        <div class="result-stats">
          <div class="result-row"><span>最终得分</span><span id="final-score">0</span></div>
          <div class="result-row"><span>最高连击</span><span id="final-max-combo">0</span></div>
          <div class="result-row"><span>历史最高</span><span id="final-high-score">0</span></div>
        </div>
        <div class="menu-buttons">
          <button class="btn btn-primary" data-action="restart">重新开始</button>
          <button class="btn" data-action="to-menu">返回主菜单</button>
        </div>
      </div>
    </div>

    <!-- 关卡过场 -->
    <div id="level-intro" class="overlay hidden">
      <div class="intro-content">
        <div id="intro-level-name" class="intro-level-name"></div>
        <div class="intro-sub">LEVEL START</div>
      </div>
    </div>

    <!-- 浮动伤害/分数文字层 -->
    <div id="float-layer" class="float-layer"></div>
  </div>

  <script>
    (function() {
      var t = Date.now();
      var scripts = [
        'js/config.js',
        'js/utils.js',
        'js/input.js',
        'js/entity.js',
        'js/systems.js',
        'js/render.js',
        'js/levels.js',
        'js/game.js'
      ];
      scripts.forEach(function(src) {
        var s = document.createElement('script');
        s.src = src + '?v=18&t=' + t;
        s.async = false;
        document.body.appendChild(s);
      });

      // Ensure Game.init runs after all scripts have executed (dynamic scripts may
      // load after DOMContentLoaded has already fired).
      var initScript = document.createElement('script');
      initScript.async = false;
      initScript.textContent =
        "(function waitInit(){ " +
        "  if (typeof Game !== 'undefined' && Game.init) { " +
        "    Game.init(); " +
        "  } else { " +
        "    setTimeout(waitInit, 50); " +
        "  } " +
        "})();";
      document.body.appendChild(initScript);
    })();
  </script>
</body>
</html>
